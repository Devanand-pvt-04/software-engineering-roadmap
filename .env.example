# Cloud sync (optional). Without these the app still works and saves progress in the browser.

# Random secret for Auth.js: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# GitHub OAuth app (https://github.com/settings/developers → New OAuth App)
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Postgres connection string (Neon via Vercel Storage sets this automatically)
DATABASE_URL=
